{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "C++ Compile",
            "type": "process",
            "command": "C:/mingw64/bin/g++.exe",
            "args": [
                "-g",
                "${file}",
                "-o",
                "${workspaceFolder}/.vscode/active.exe",
                "-fexec-charset=GBK"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "detail": "编译当前文件并生成固定英文名的调试程序 .vscode/active.exe"
        },
        {
            "label": "C++ Compile (C++17)",
            "type": "process",
            "command": "C:/mingw64/bin/g++.exe",
            "args": [
                "-g",
                "-std=c++17",
                "${file}",
                "-o",
                "${workspaceFolder}/.vscode/active.exe",
                "-fexec-charset=GBK"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": "build",
            "detail": "需要 C++17 语法（如 <bits/stdc++.h>、auto、结构体排序）时用这个"
        },
        {
            "label": "C++ Run exe (no debug)",
            "type": "process",
            "command": "${workspaceFolder}/.vscode/active.exe",
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [],
            "detail": "只运行已经编译好的 exe，不进入调试"
        },
        {
            "type": "cppbuild",
            "label": "C/C++: g++.exe 生成活动文件",
            "command": "C:/mingw64/bin/g++.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${file}",
                "-o",
                "${workspaceFolder}\\.vscode\\active.exe"
            ],
            "options": {
                "cwd": "C:/mingw64/bin"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "调试器生成的任务。"
        }
    ]
}